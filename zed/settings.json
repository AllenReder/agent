// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "collaboration_panel": {
    "button": false
  },
  "tabs": {
    "git_status": false
  },
  "title_bar": {
    "show_branch_status_icon": false
  },
  "search": {
    "button": true
  },
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 400.0,
  "project_panel": {
    "git_status_indicator": true,
    "dock": "left"
  },
  "agent": {
    "button": true,
    "tool_permissions": {
      "default": "allow"
    },
    "sidebar_side": "right",
    "dock": "right",
    "terminal_init_command": "",
    "default_profile": "write",
    "default_model": {
      "provider": "AllenPI",
      "model": "MiniMax-M3",
      "enable_thinking": false,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "language_models": {
    "openai_compatible": {
      "MiniMax": {
        "api_url": "https://api.minimaxi.com/v1",
        "available_models": [
          {
            "name": "MiniMax-M3",
            "max_tokens": 1000000,
            "max_output_tokens": 100000,
            "max_completion_tokens": 100000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": true,
            },
          },
        ],
      },
      "AllenPI": {
        "api_url": "https://api.example.top/v1",
        "available_models": [
          {
            "name": "gpt-5.6-sol",
            "max_tokens": 256000,
            "max_output_tokens": 128000,
            "max_completion_tokens": 128000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": false,
            },
          },
          {
            "name": "gpt-5.6-terra",
            "max_tokens": 256000,
            "max_output_tokens": 128000,
            "max_completion_tokens": 128000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": false,
            },
          },
          {
            "name": "gpt-5.6-luna",
            "max_tokens": 256000,
            "max_output_tokens": 128000,
            "max_completion_tokens": 128000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": false,
            },
          },
          {
            "name": "MiniMax-M3",
            "max_tokens": 1000000,
            "max_output_tokens": 100000,
            "max_completion_tokens": 100000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": false,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": false,
            },
          },
        ],
      },
    },
  },
  "context_servers": {
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "vim_mode": false,
  "terminal": {
    "font_size": 15.0,
    "font_family": "MesloLGS NF",
    "font_fallbacks": ["Microsoft Yahei", "monospace"],
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "proxy": "http://127.0.0.1:7890",
  "git_panel": {
    "status_style": "icon",
    "file_icons": true,
    "button": true,
  },
  "minimap": {
    "show": "never",
  },
  "cursor_blink": true,
  "buffer_font_fallbacks": ["Microsoft Yahei", "monospace"],
  "buffer_font_family": "JetBrains Mono",
  "linked_edits": true,
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "fast-mode": false,
        "mode": "agent-full-access"
      },
      "type": "registry",
    },
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16.0,
  "buffer_font_size": 15.0,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "VSCode Dark Modern"
  },
}
